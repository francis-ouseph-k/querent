# ============================================================
# Digital Evaluation System — NL→SQL
# ENVIRONMENT TEMPLATE  (copy to .env and fill in)
# ============================================================
#   cp .env.example .env
#
# Legend:
#   [DEFAULT]   — matches settings.py default; included for visibility
#   [OPTIONAL]  — safe to leave blank
#   [CHANGE ME] — must be updated before use
#
# NO REAL CREDENTIALS BELONG IN THIS FILE. Every secret is blank by design.
# ============================================================


# ============================================================
# QDRANT (VECTOR STORE — DENSE RETRIEVAL)
# ============================================================

QDRANT_HOST=localhost                    # [DEFAULT]
QDRANT_PORT=6333                         # [DEFAULT]
QDRANT_COLLECTION_NAME=schema_chunks     # [DEFAULT]


# ============================================================
# OPENSEARCH (BM25 SPARSE RETRIEVAL)
# ============================================================

OPENSEARCH_HOST=localhost                # [CONFIRMED]
OPENSEARCH_PORT=9200                     # [DEFAULT]
OPENSEARCH_INDEX_NAME=schema_chunks      # [DEFAULT]
OPENSEARCH_USERNAME=admin                # [DEFAULT]
OPENSEARCH_PASSWORD=                     # [CHANGE ME] — required, no default; set locally, never commit
#OPENSEARCH_USE_SSL=false                # [DEFAULT] — set true if SSL is enabled
OPENSEARCH_USE_SSL=true                  # [DEFAULT] — set true if SSL is enabled
OPENSEARCH_VERIFY_CERTS=false           # [DEFAULT] — set false if using self-signed certs


# ============================================================
# POSTGRESQL (READ-ONLY REPLICA)
# ============================================================

PG_HOST=localhost                        # [CONFIRMED]
PG_PORT=5432                             # [DEFAULT]
PG_DATABASE=digital_evaluation_db        # [CONFIRMED]
PG_USER=postgres                         # [CONFIRMED]
PG_PASSWORD=                             # [CHANGE ME] — blank only for local trust/peer auth
PG_POOL_MIN=2                            # [DEFAULT]
PG_POOL_MAX=20                           # [DEFAULT] — tune for peak load (5,000 evaluators)
PG_STATEMENT_TIMEOUT_MS=30000            # [DEFAULT] — 30s hard ceiling per query
PG_MAX_ROWS=1000                         # [DEFAULT] — result set ceiling


# ============================================================
# LLM (INFERENCE ENGINE CONFIGURATION)
# Supports two modes of execution:
#   Approach A: Decoupled Server Mode (HTTP REST Client)
#     Connects to an external llama-server.exe process via HTTP.
#     Provide LLM_BASE_URL (e.g. http://localhost:8080/v1) to enable.
#   Approach B: In-Process Fallback Mode (llama-cpp-python bindings)
#     Loaded directly in-process via python bindings using LLM_MODEL_PATH.
#     Used if LLM_BASE_URL is not configured OR if the C++ server is unreachable.
# ============================================================

# ── PROVIDER SELECTION ──────────────────────────────────────────────────────
# Which backend generates SQL.
#   local            — llama.cpp direct: llama-server via LLM_BASE_URL, with
#                      in-process llama-cpp-python fallback.  [DEFAULT]
#   local_langchain  — the same llama-server, reached through LangChain
#                      (requires LLM_BASE_URL; no in-process fallback).
#   mistral          — Mistral La Plateforme, via LangChain.
#   gemini           — Google Gemini Flash 2, via LangChain.
#
# Every LangChain provider talks to an OpenAI-compatible /v1 endpoint, so each
# one is configured by the same triple: BASE_URL + API_KEY + MODEL.
LLM_PROVIDER=local

# Primary: Qwen Coder 3B on the local llama-server (OpenAI-compatible /v1).
# LLM_BASE_URL and LLM_MODEL_PATH keep their historical names (below).
# LLM_PRIMARY_MODEL is the model id sent in the request body and shown in the
# startup banner — NOT the GGUF path.
LLM_PRIMARY_MODEL=qwen2.5-coder-3b-instruct

# Mistral (OpenAI-compatible endpoint)
LLM_MISTRAL_BASE_URL=https://api.mistral.ai/v1
LLM_MISTRAL_API_KEY=your-mistral-key-here
LLM_MISTRAL_MODEL=mistral-small-latest

# Gemini Flash 2 (Google OpenAI-compatibility endpoint)
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_GEMINI_API_KEY=your-gemini-key-here
LLM_GEMINI_MODEL=gemini-3.5-flash

# Two SEPARATE timeouts. The local primary can spend its first request loading
# the GGUF into VRAM and needs real time on the 10-14k-token serve prompt;
# Mistral/Gemini get a shorter leash, since a slow cloud response usually means
# something is actually wrong.
LLM_PRIMARY_TIMEOUT_SECONDS=120
LLM_TIMEOUT_SECONDS=90

LLM_BASE_URL=http://localhost:8080/v1  # [OPTIONAL] — url of the decoupled llama-server.exe
LLM_MODEL_PATH=../models/qwen/qwen2.5-coder-3b-instruct-q4_k_m.gguf  # [DEFAULT] — path for in-process fallback
# LLM_CONTEXT_SIZE=8192                    # [DEFAULT]
# LLM_MAX_TOKENS=512                       # [DEFAULT]
#LLM_CONTEXT_SIZE=16384                   # [TUNED] — previous value
LLM_CONTEXT_SIZE=32768                   # [TUNED] — model supports 32K natively; requires -c 32768 on llama-server
## LLM_MAX_TOKENS=1024                   # [TUNED]
LLM_MAX_TOKENS=2048                      # [TUNED]
#PS D:\..\llama-precompiled> .\llama-server.exe -m ..\models\qwen\qwen2.5-coder-3b-instruct-q4_k_m.gguf -ngl 28 -c 32768 --chat-template chatml > ..\logs\llama-server_qwen.log 2>&1

LLM_TEMPERATURE=0.2                      # [DEFAULT] — raise to 0.4 for more creative rewrites
LLM_N_GPU_LAYERS=-1                      # [DEFAULT] — -1 = all layers on GPU; 0 = CPU only
LLM_N_THREADS=8                          # [DEFAULT]
# Repetition penalties to mitigate model collapse & query loops (e.g. repeating "AND qp.is_locked = FALSE" infinite times):
#   - LLM_FREQUENCY_PENALTY: Penalizes tokens proportionally to their cumulative count in the text so far.
#     The more times a clause/word repeats, the heavier the penalty becomes. This directly breaks repetition loops.
#   - LLM_PRESENCE_PENALTY: Flat-rate penalty for a token as soon as it appears once, encouraging topic/vocabulary diversity.
LLM_FREQUENCY_PENALTY=0.1                # [TUNED]
LLM_PRESENCE_PENALTY=0.1                 # [TUNED]

# FIX-F1 — prompt profile. WHICH prompt distribution the pipeline serves:
#   full (default) — the rich 10-14k-token serve prompt. Use for the BASE model.
#   ft             — training-parity prompt: short train system prompt in a real
#                    system role + budgeted SCHEMA+QUESTION user turn.
#                    REQUIRED whenever llama-server serves a fine-tuned GGUF —
#                    the adapter is specialised to this shape; the full prompt
#                    is out-of-distribution for it and degrades it below base.
#
# Quick reference: base model = full, fine-tuned model = ft. 
#  - Model and profile always travel as a pair.
#  - RESULT-1 (base):       LLM_PROMPT_PROFILE=full
#  - RESULT-2 (fine-tuned): LLM_PROMPT_PROFILE=full   # [DEFAULT] — base GGUF. Set to "ft" only when serving a fine-tuned GGUF. Ignored (forced to "full") for hosted providers.
LLM_PROMPT_PROFILE=ft


# ============================================================
# EMBEDDING (BGE-SMALL — RUNS IN-PROCESS)
# ============================================================

EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5  # [DEFAULT]
EMBED_BATCH_SIZE=32                       # [DEFAULT]
EMBED_DEVICE=cpu                          # [DEFAULT] — set to "cuda" only if GPU is free


# ============================================================
# RETRIEVAL
# ============================================================

RETRIEVAL_DENSE_TOP_K=20                 # [DEFAULT]
RETRIEVAL_BM25_TOP_K=20                  # [DEFAULT]
RETRIEVAL_RRF_K=60                       # [DEFAULT] — standard RRF constant
#RETRIEVAL_CONTEXT_BUDGET_TOKENS=7000    # [DEFAULT]
RETRIEVAL_CONTEXT_BUDGET_TOKENS=9000     # [TUNED] — schema context window budget
#RETRIEVAL_MAX_CONTEXT_BUDGET_TOKENS=12000 # [DEFAULT] — previous value
RETRIEVAL_MAX_CONTEXT_BUDGET_TOKENS=20000 # [TUNED] — raised ceiling for retry context; fits within 32K context window



# ============================================================
# RERANKER (OPTIONAL — PHASE 1+)
# ============================================================

RERANKER_ENABLED=false                   # [DEFAULT] — enable only when retrieval is bottleneck
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2  # [DEFAULT]
RERANKER_TOP_K_INPUT=20                  # [DEFAULT]
RERANKER_TOP_K_OUTPUT=10                 # [DEFAULT]


# ============================================================
# VALIDATION
# ============================================================

VALIDATION_MAX_RETRIES=4                 # [TUNED]
VALIDATION_EXPLAIN_COST_THRESHOLD=1000000  # [DEFAULT] — reject queries above this EXPLAIN cost


# ============================================================
# PATHS
# ============================================================

DDL_PATH=data/docs/digital_evaluation_schema_v10_10.sql  # [CONFIRMED] — v10.10 is the authoritative schema. Re-run `python ingest.py` after changing this.
GLOSSARY_PATH=data/glossary.json                   # [DEFAULT]
FAILURE_LOG_DIR=failures                           # [DEFAULT]
LOG_DIR=logs                                       # [DEFAULT]


# ============================================================
# TENANT / SECURITY
# ============================================================

TENANT_COLUMN=                           # [DEFAULT] — empty = multi-tenant via search_path
RLS_VARIABLE=app.current_user_id         # [DEFAULT]


# ============================================================
# FEATURE FLAGS
# ============================================================

DRY_RUN_DEFAULT=true                     # [DEFAULT] — safe default; use --exec to override
STRICT_MODE=false                        # [DEFAULT] — make schema version drift mismatch fatal
SHOW_SQL_IN_CLI=true                     # [DEFAULT]
SHOW_EXPLANATION_IN_CLI=true             # [DEFAULT]
CONFIDENCE_WARN_THRESHOLD=0.60           # [DEFAULT]
## USE_MCP_SERVERS=false                    # [DEFAULT] — set true to route through MCP servers (all four must be running first)
USE_MCP_SERVERS=false

## BATCH_QUERY_DELAY_MS=0                   # [DEFAULT] — pause (ms) between batch_run.py questions; 0 = no delay.
#   Raise this if a hosted LLM_PROVIDER (mistral/gemini) starts returning
#   rate-limit errors during a long batch run. Applied between questions
#   only -- never before the first -- so a single --query run is unaffected.
BATCH_QUERY_DELAY_MS=0


# ============================================================
# ── MCP Servers ─────────────────────────────────────────────
# ============================================================
MCP_QDRANT_HOST=127.0.0.1
MCP_QDRANT_PORT=5010
MCP_OPENSEARCH_HOST=127.0.0.1
MCP_OPENSEARCH_PORT=5011
MCP_POSTGRES_HOST=127.0.0.1
MCP_POSTGRES_PORT=5012
MCP_CORPUS_HOST=127.0.0.1
MCP_CORPUS_PORT=5013
MCP_CORPUS_BACKEND=local
## TO ENABLE Drive #MCP_CORPUS_BACKEND=drive
## TODO EXAMPLE ONLY MCP_CORPUS_DRIVE_FOLDER_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74
MCP_CORPUS_DRIVE_FOLDER_ID=


# ============================================================
# ── Fine-tuning (Phase2)─────────────────────────────────────
# ============================================================
# Phase-2 fine-tuning paths (defaults shown; uncomment to override)
FT_ADAPTER_DIR=../models/adapters
##FT_HF_MODEL_DIR=../models/hf/Qwen2.5-Coder-3B-Instruct
FT_HF_MODEL_DIR=../models/hf/Qwen2.5-Coder-3B-Instruct   # [CHANGE ME] — or an HF snapshot dir
##FT_TRAIN_DATA=data/fine_tuning_train.jsonl
FT_TRAIN_DATA=data/fine_tuning_train.fit.jsonl

# ── SINGLE token-budget knob (drives BOTH preprocess fit + trainer max_seq) ──
# One value. The preprocessor fits every row to this budget and the trainer sets
# SFTConfig.max_seq_length to the same number, so the corpus and the training
# ceiling can never diverge. Diverge = rows truncated past the assistant turn =
# completion-only collator masks the whole sequence = zero loss = dead adapter.
# Do NOT set below the reserve floor (system+question+output JSON+template);
# measured max reserve on the current corpus is ~1112 tok, so 1024 is unsafe.
# HISTORY: 2048 (v4) -> 2560 (v5) -> 3072 (v6). 3072 spilled ~4.5GB into shared
# RAM on the 8GB card and ran ~21 min/step (expandable_segments is Linux-only,
# silently ignored on Windows). 2816 is the anti-spill ceiling. Rebuild the
# corpus after ANY change (one knob drives fit + trainer). R3 gold-chunk
# compression keeps reject:gold_over_budget near zero at this budget.
# Canonical name: MAX_SEQ_LENGTH (default 2048 when unset). Legacy alias
# FT_MAX_SEQ is still accepted; if both are set, MAX_SEQ_LENGTH wins.
## MAX_SEQ_LENGTH=2048
## MAX_SEQ_LENGTH=2560
## MAX_SEQ_LENGTH=3072
# Max we will for V7 go without spilling "too much" into the shared RAM.
MAX_SEQ_LENGTH=2816

# export.py output locations — MUST match the sibling ../models layout that
# llama-server serves from (defaults are in-project models/ and will misplace the GGUF):
FT_MERGED_DIR=../models/merged
FT_GGUF_OUTPUT_DIR=../models/qwen
# Only needed if you run evaluator.py (not part of the batch_run A/B workflow):
#FT_EVAL_DATA=data/fine_tuning_eval.jsonl
#FT_BASELINE_PATH=data/eval_baseline.json

# ── llama.cpp tool paths (fine_tuning/export.py) ─────────────────────────────
# REQUIRED. External, shared llama.cpp checkout that contains convert_hf_to_gguf.py.
# No default in code — set it here or in the environment.
#   Windows example:
LLAMA_CPP_SOURCE=   # [CHANGE ME] — llama.cpp checkout containing convert_hf_to_gguf.py

# OPTIONAL. Directory holding the precompiled quantiser/server binaries.
# Default (if unset) is the repo-relative "llama-precompiled" sitting beside the
# project inside the workspace. Override only if yours lives elsewhere.
LLAMA_PRECOMPILED=   # [OPTIONAL] — dir with llama-quantize / llama-server binaries


# OPTIONAL. Binary NAMES eith extensions override for Linux/WSL (no .exe).
LLAMA_QUANTIZE_BIN=llama-quantize.exe
LLAMA_SERVER_BIN=llama-server.exe

# OPTIONAL. Where the Step-1 merge runs: cuda:0 (default, fast, ~6 GB VRAM) or
# cpu (slower, uses system RAM — use if the GPU merge OOMs on an 8 GB card).
#  cuda:0 → first GPU
#  cuda:1 → second GPU
#  cuda:2 → third, etc.
# Current machine has one card (the RTX 5060 Ti), so it's always cuda:0. On a multi-GPU box you'd pick which one with the index.
FT_MERGE_DEVICE=cuda:0